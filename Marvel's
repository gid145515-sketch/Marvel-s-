<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top, #401010 0%, #120000 35%, #050505 75%);
    color:white;
    min-height:100vh;
    padding:25px 12px 50px;
}

/* TOP */
.hero{
    text-align:center;
    padding:35px 15px;
    border:2px solid #e62429;
    border-radius:25px;
    max-width:900px;
    margin:auto;
    background:linear-gradient(145deg,#220000,#080808);
    box-shadow:0 0 30px rgba(230,36,41,.45);
}

.hero h1{
    font-size:clamp(30px,7vw,65px);
    letter-spacing:4px;
    color:#e62429;
    text-shadow:0 0 15px #e62429;
}

.hero h2{
    margin-top:10px;
    font-size:18px;
    color:#ddd;
    letter-spacing:2px;
}

.hero p{
    margin-top:15px;
    color:#aaa;
}

/* ARC REACTOR */
.arc{
    width:75px;
    height:75px;
    margin:25px auto 0;
    border:5px solid #7deaff;
    border-radius:50%;
    box-shadow:
        0 0 10px #7deaff,
        0 0 30px #00c8ff,
        inset 0 0 20px #00c8ff;
    display:flex;
    align-items:center;
    justify-content:center;
    animation:pulse 2s infinite;
}

.arc::after{
    content:"";
    width:25px;
    height:25px;
    background:#fff;
    border-radius:50%;
    box-shadow:0 0 20px #00c8ff;
}

@keyframes pulse{
    50%{
        transform:scale(1.08);
    }
}

/* PROGRESS */
.progress-box{
    max-width:900px;
    margin:25px auto;
    padding:20px;
    background:#111;
    border:1px solid #333;
    border-radius:18px;
    text-align:center;
}

.progress-text{
    font-size:18px;
    margin-bottom:12px;
}

.progress-bar{
    height:14px;
    background:#292929;
    border-radius:20px;
    overflow:hidden;
}

.progress-fill{
    width:0%;
    height:100%;
    background:linear-gradient(90deg,#e62429,#ffb000);
    transition:.4s;
}

/* MOVIE LIST */
.movie-list{
    max-width:900px;
    margin:auto;
}

.movie{
    display:flex;
    align-items:center;
    gap:15px;
    margin:12px 0;
    padding:15px;
    background:linear-gradient(90deg,#151515,#090909);
    border:1px solid #292929;
    border-left:5px solid #e62429;
    border-radius:15px;
    transition:.25s;
}

.movie:hover{
    transform:translateX(6px);
    border-color:#e62429;
    box-shadow:0 0 18px rgba(230,36,41,.25);
}

.movie-number{
    min-width:42px;
    height:42px;
    border-radius:50%;
    background:#e62429;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
    box-shadow:0 0 12px rgba(230,36,41,.5);
}

.movie-info{
    flex:1;
}

.movie-title{
    font-size:17px;
    font-weight:bold;
}

.movie-year{
    color:#999;
    margin-top:5px;
    font-size:14px;
}

.movie input{
    width:22px;
    height:22px;
    accent-color:#e62429;
    cursor:pointer;
}

/* CHECKED */
.movie:has(input:checked){
    opacity:.55;
    border-left-color:#777;
}

.movie:has(input:checked) .movie-title{
    text-decoration:line-through;
}

/* FOOTER */
.footer{
    max-width:900px;
    margin:35px auto 0;
    text-align:center;
    color:#777;
    line-height:1.7;
}

.footer strong{
    color:#e62429;
}

/* MOBILE */
@media(max-width:600px){
    body{
        padding:15px 8px 35px;
    }

    .hero{
        padding:28px 10px;
    }

    .movie{
